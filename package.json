{
  "name": "prooffolio",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-backed student portfolio, ATS-friendly resume builder and career readiness app.",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs",
    "cap:add": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run cap:sync && cap run android",
    "cap:assets": "capacitor-assets generate --android --assetPath resources",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  }
}
