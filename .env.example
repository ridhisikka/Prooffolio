# Copy to .env for local development (never commit .env).
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# --- Server only (secret) ---
ANTHROPIC_API_KEY=
# Optional: model used by /api/ai (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional: extra browser origins allowed to call /api/ai (comma separated), e.g. a custom domain
ALLOWED_ORIGINS=

# --- Build time (public, baked into js/config.js) ---
# Leave empty for the website. For the Android app set both to your deployed https address.
PF_API_BASE=
PF_PUBLIC_URL=
PF_APP_NAME=Prooffolio
# Shown in privacy.html and terms.html
PF_OPERATOR_NAME=
PF_CONTACT_EMAIL=
